{
  "name": "keep-reminder",
  "version": "0.1.0",
  "type": "module",
  "description": "Inject a user-defined .keep-reminder file into context as <system-reminder>, with session/turn/request modes.",
  "license": "Apache-2.0",
  "exports": "./lib/index.js",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "README.md",
    "README.zh.md",
    "LICENSE",
    ".keep-reminder.example"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "reminder",
    "system-reminder",
    "plugin",
    "context"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*",
    "@types/node": "^26.2.0",
    "typescript": "^5"
  }
}